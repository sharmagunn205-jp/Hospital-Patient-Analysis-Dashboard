table 'hospital data analysis'
	lineageTag: aab9e1de-16f3-8176-f86d-7a92ba337a8d

	measure 'Total Patients' = COUNTROWS('hospital data analysis')
		formatString: #,0
		lineageTag: 5fb5d129-eff5-d045-e390-b9781a87a5b4

	measure 'Total Cost' = SUM('hospital data analysis'[Cost])
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 22722a40-6284-9c98-fe51-94739d5f2b6e

	measure 'Avg Cost per Patient' = DIVIDE([Total Cost], [Total Patients])
		formatString: $#,0
		lineageTag: b0992e99-7b7e-3775-67bc-05e22894eedb

	measure 'Avg Length of Stay' = AVERAGE('hospital data analysis'[Length_of_Stay])
		formatString: 0.0
		lineageTag: 1d4698da-bf18-8e9a-3e08-8ee8a1b098b6

	measure 'Avg Satisfaction' = AVERAGE('hospital data analysis'[Satisfaction])
		formatString: 0.00
		lineageTag: 95292bc3-bf0a-f75d-bda1-b577d7fbaa55

	measure 'Readmitted Patients' = CALCULATE([Total Patients], 'hospital data analysis'[Readmission] = "Yes")
		formatString: #,0
		lineageTag: 8769da69-6be2-2d2e-919e-cb831a059b47

	measure 'Readmission Rate' = DIVIDE([Readmitted Patients], [Total Patients])
		formatString: 0.0%
		lineageTag: 01d797b4-cacb-f5ff-0676-75003d68e22b

	measure 'Recovery Rate' = DIVIDE(CALCULATE([Total Patients], 'hospital data analysis'[Outcome] = "Recovered"), [Total Patients])
		formatString: 0.0%
		lineageTag: 170a85d2-e7b7-12ee-32e7-db02701f8838

	column Patient_ID
		dataType: int64
		formatString: 0
		lineageTag: 6ac8b68c-a767-bad9-b989-799b289337f8
		summarizeBy: none
		sourceColumn: Patient_ID

		annotation SummarizationSetBy = Automatic

	column Age
		dataType: int64
		formatString: 0
		lineageTag: 1622e3e5-1c33-41b0-3ec8-4636bf2f4db1
		summarizeBy: none
		sourceColumn: Age

		annotation SummarizationSetBy = Automatic

	column Gender
		dataType: string
		lineageTag: 0c54f163-39c8-0734-8758-79159146edf3
		summarizeBy: none
		sourceColumn: Gender

		annotation SummarizationSetBy = Automatic

	column Condition
		dataType: string
		lineageTag: d6c3bd18-8f17-6b2f-1e6c-6bb5384d791d
		summarizeBy: none
		sourceColumn: Condition

		annotation SummarizationSetBy = Automatic

	column Procedure
		dataType: string
		lineageTag: 9c099486-a8b1-f675-cd2d-14fb90b66007
		summarizeBy: none
		sourceColumn: Procedure

		annotation SummarizationSetBy = Automatic

	column Cost
		dataType: int64
		formatString: $#,0
		lineageTag: c6fd5425-d5e3-b37e-1914-3e1b2c2460ab
		summarizeBy: sum
		sourceColumn: Cost

		annotation SummarizationSetBy = Automatic

	column Length_of_Stay
		dataType: int64
		formatString: 0
		lineageTag: 024aa835-e8a5-ab9e-a274-97fd3e345417
		summarizeBy: sum
		sourceColumn: Length_of_Stay

		annotation SummarizationSetBy = Automatic

	column Readmission
		dataType: string
		lineageTag: 14098a9a-7379-5692-3074-22718a2be8f9
		summarizeBy: none
		sourceColumn: Readmission

		annotation SummarizationSetBy = Automatic

	column Outcome
		dataType: string
		lineageTag: b3766c84-1ee1-0af0-0e2b-fdaf7a461d1e
		summarizeBy: none
		sourceColumn: Outcome

		annotation SummarizationSetBy = Automatic

	column Satisfaction
		dataType: int64
		formatString: 0
		lineageTag: 939275f1-6301-2510-22e0-8c9d61873cd3
		summarizeBy: none
		sourceColumn: Satisfaction

		annotation SummarizationSetBy = Automatic

	column 'Age Group'
		dataType: string
		lineageTag: 331d5df2-2bc9-c3b3-7201-a9b60d570835
		summarizeBy: none
		sourceColumn: Age Group
		sortByColumn: 'Age Group Sort'

		annotation SummarizationSetBy = Automatic

	column 'Age Group Sort'
		dataType: int64
		formatString: 0
		lineageTag: a77273c4-fde4-2e86-e4a5-a28eefb60de0
		summarizeBy: none
		sourceColumn: Age Group Sort

		annotation SummarizationSetBy = Automatic

	partition 'hospital data analysis' = m
		mode: import
		source =
				let
					Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.None]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"Patient_ID", Int64.Type},{"Age", Int64.Type},{"Gender", type text},{"Condition", type text},{"Procedure", type text},{"Cost", Int64.Type},{"Length_of_Stay", Int64.Type},{"Readmission", type text},{"Outcome", type text},{"Satisfaction", Int64.Type}}),
					NoBlank = Table.SelectRows(Typed, each [Patient_ID] <> null),
					AgeGroup = Table.AddColumn(NoBlank, "Age Group", each if [Age] < 30 then "Under 30" else if [Age] < 45 then "30-44" else if [Age] < 60 then "45-59" else if [Age] < 75 then "60-74" else "75+", type text),
					AgeSort = Table.AddColumn(AgeGroup, "Age Group Sort", each if [Age] < 30 then 1 else if [Age] < 45 then 2 else if [Age] < 60 then 3 else if [Age] < 75 then 4 else 5, Int64.Type)
				in
					AgeSort

	annotation PBI_ResultType = Table

